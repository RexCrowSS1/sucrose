DISCORD_TOKEN=isi_token_bot_di_sini
CLIENT_ID=1547892706393726976
# Gunakan ID server untuk pendaftaran command langsung di server pengujian.
# Kosongkan untuk mendaftarkan command global.
GUILD_ID=
# ID akun Discord pemilik; khusus perintah /profile (profil global bot).
OWNER_IDS=
DATA_FILE=./data/config.json

# Ollama lokal. Jalankan `ollama serve` dan `ollama pull llama3.2` bila model belum ada.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=120
OLLAMA_SYSTEM_PROMPT="Kamu Sucrose, teman ngobrol di Discord. Jawab dengan ramah, jelas, dan ringkas dalam bahasa Indonesia kecuali diminta bahasa lain."
AI_COOLDOWN_SECONDS=5
AI_HISTORY_TURNS=6
AI_HISTORY_TTL_SECONDS=1800
AI_MAX_CONVERSATIONS=500
AI_MAX_CONCURRENT=2

# Render Free: PostgreSQL eksternal dengan TLS (isi melalui Environment Render).
# Kosongkan untuk tetap memakai file JSON pada komputer lokal.
DATABASE_URL=
# Set false jika layanan Ollama belum tersedia pada hosting.
AI_ENABLED=true
# Opsional: Bearer token untuk endpoint Ollama/proxy yang memerlukan autentikasi.
OLLAMA_API_KEY=
